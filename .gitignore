# Local secrets: never commit real API keys
config.yaml
config.yaml.bak
*.bak

# Runtime state snapshots. cooldowns.json holds upstream API keys, so it must
# never be committed.
stats.json
stats.json.tmp
cooldowns.json
cooldowns.json.tmp

# Build artifacts
*.exe
build/bin/
*.out

# Debug leftovers
probe-*.txt

# Go build cache only. Do NOT widen this to `go.*`: that pattern also matches
# go.mod and go.sum, and excluding those leaves a fresh clone with no module
# at all (nothing builds, and the Dockerfile's `COPY go.mod go.sum` fails).
go-build*

# Wails build cache
.wails/

# Local Go module/cache dirs
.gopath/
.gocache/

# OS artifacts
.DS_Store
Thumbs.db
*.user
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
